{
  "name": "easytier-docs",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "description": "从零理解 EasyTier 的中文本地教程网站",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=20",
    "test": "node -e \"require('node:fs').mkdirSync('coverage/.tmp', { recursive: true })\" && vitest run && pnpm test:types",
    "test:dev": "node -e \"require('node:fs').mkdirSync('coverage/.tmp', { recursive: true })\" && vitest",
    "lint": "turbo run lint",
    "tsd": "turbo run tsd",
    "test:types": "turbo run test:types",
    "audit": "pnpm audit --audit-level=moderate",
    "audit:fix": "pnpm audit --fix",
    "cf-typegen": "pnpm --filter @icebreakers/client --filter @icebreakers/server run cf-typegen",
    "cf-typegen:check": "pnpm --filter @icebreakers/client --filter @icebreakers/server run cf-typegen:check",
    "typecheck": "turbo run typecheck",
    "format": "eslint . --fix",
    "validate": "pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run tsd && pnpm run test",
    "release": "pnpm change",
    "version-packages": "pnpm version -r",
    "publish-packages": "repo release stable publish",
    "release:pre": "repo release pre publish",
    "------": "--------------",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "postinstall": "pnpm run build",
    "commit": "commit",
    "commitlint": "commitlint --edit",
    "sync": "pnpm sync:npmmirror",
    "sync:npmmirror": "repo release sync-npmmirror --all",
    "release:sync-npmmirror": "repo release sync-npmmirror --published",
    "inspector": "npx @eslint/config-inspector",
    "build:inspector": "pnpm build && npx @eslint/config-inspector build",
    "-------": "---------------",
    "repo:init": "repo init",
    "repo:new": "repo new",
    "repo:check": "repo check",
    "repo:doctor": "repo doctor",
    "------simple": "--------------",
    "pr:alpha": "repo release pre enter alpha",
    "pr:beta": "repo release pre enter beta",
    "pr:rc": "repo release pre enter rc",
    "pr:next": "repo release pre enter next",
    "pr:exit": "repo release pre exit",
    "--------": "----------------",
    "docs:dev": "pnpm --dir apps/website dev",
    "docs:build": "pnpm --dir apps/website build",
    "docs:preview": "pnpm --dir apps/website preview",
    "docs:deploy": "pnpm exec wrangler deploy"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@eslint/config-inspector": "^3.5.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "~5.0.3",
    "eslint": "^10.12.0",
    "execa": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "only-allow": "^1.2.2",
    "repoctl": "5.10.3",
    "stylelint": "^17.16.0",
    "tailwindcss": "^4.3.3",
    "tsd": "^0.33.0",
    "tsdown": "0.23.0",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "vitest": "~5.0.3",
    "wrangler": "4.149.0",
    "yaml": "^2.9.1"
  }
}
