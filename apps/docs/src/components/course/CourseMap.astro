---
import { basics, chapterLink, chapters, internals, stages } from '../../data/course'
---

<div class="course-map">
  <section class="course-stage">
    <div class="stage-heading">
      <span class="course-kicker">预备 1—5</span>
      <h2>先在本机看见</h2>
      <p>从网页启停和界面读数开始，知道请求者、服务、地址、端口各是什么。</p>
      <a href="/basics">准备说明与实验包 →</a>
    </div>
    <ol class="course-list">
      {basics.map((lesson, index) => (
        <li>
          <a href={lesson.route}>
            <span class="course-number">预备 {index + 1}</span>
            <span class="course-description">
              <strong>{lesson.title.split(' · ')[1]}</strong>
              <small>{lesson.goal}</small>
            </span>
            <span class="course-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
  {stages.map(stage => (
    <section class="course-stage">
      <div class="stage-heading">
        <span class="course-kicker">{stage.range}</span>
        <h2>{stage.title}</h2>
        <p>{stage.goal}</p>
      </div>
      <ol class="course-list" start={stage.start + 1}>
        {chapters.slice(stage.start, stage.end).map(([slug, title, description]) => (
          <li>
            <a href={chapterLink(slug)}>
              <span class="course-number">{slug.slice(0, 2)}</span>
              <span class="course-description">
                <strong>{title}</strong>
                <small>{description}</small>
              </span>
              <span class="course-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  ))}
  <section class="course-stage">
    <div class="stage-heading">
      <span class="course-kicker">进阶 1—6 · 正文之后选读</span>
      <h2>拆开协议，连接核心原理</h2>
      <p>从协议地图进入包的内部，再看建链、安全、传输与抓包。每页标明前置章节，以图解连接直觉、实现和证据。</p>
    </div>
    <ol class="course-list">
      {internals.map((lesson, index) => (
        <li><a href={lesson.route}>
          <span class="course-number">进阶 {index + 1}</span>
          <span class="course-description"><strong>{lesson.title.split(' · ')[1]}</strong><small>{lesson.goal}</small></span>
          <span class="course-arrow" aria-hidden="true">→</span>
        </a></li>
      ))}
    </ol>
  </section>
</div>
